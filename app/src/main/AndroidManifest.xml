<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Phase 1: baseline network access. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Phase 2: Wi-Fi link details (RSSI, metered state). Normal permission, no runtime prompt. -->
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />

    <!--
         Phase 2: requested at RUNTIME, only when the user taps "Allow" to see the Wi-Fi
         network name. Android gates SSID behind Location because it is, in principle, a
         location signal. The app works fully without this permission; the Wi-Fi name is
         simply reported as not permitted until it is granted.
    -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />

    <application
        android:name=".NetGuardApp"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.NetGuard">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@style/Theme.NetGuard">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
